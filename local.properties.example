# این فایل را کپی کرده و به نام local.properties ذخیره کنید.
# local.properties هرگز نباید در Git کامیت شود (در .gitignore قرار دارد).

sdk.dir=/path/to/Android/Sdk

# کلید API سرویس هوش مصنوعی Gemini (فقط در صورت استفاده مستقیم از Gemini، بدون پروکسی)
# این مقدار در زمان Build توسط Gradle به BuildConfig تزریق می‌شود
# و هرگز در سورس‌کد یا مخزن Git ذخیره نمی‌شود.
GEMINI_API_KEY=your_gemini_api_key_here

# آدرس Backend اختیاری Gemini (در صورت استفاده مستقیم از Gemini)
BACKEND_BASE_URL=https://generativelanguage.googleapis.com/

# -----------------------------------------------------------------------
# روش جایگزین: پروکسی رایگان گوگل اپس‌اسکریپت + AvalAI (تست‌شده، از جمله ویدئو)
# اگر PROXY_URL مقداردهی شود، برنامه دیگر مستقیماً با Gemini صحبت نمی‌کند و
# GEMINI_API_KEY بالا نادیده گرفته می‌شود. راهنمای کامل ساخت این آدرس در
# backend/apps-script/Code.gs و بخش README آمده است.
# -----------------------------------------------------------------------
PROXY_URL=
# رمز اختیاری برای محدود کردن دسترسی به Web App (باید در Script Properties
# اپس‌اسکریپت هم با نام APP_SECRET تنظیم شود)
APP_SECRET=

# -----------------------------------------------------------------------
# روش پیشنهادی برای نسخه تجاری: بک‌اند اعتباری Firebase (تشخیص هویت با
# Firebase Anonymous Auth + کنترل موجودی در Firestore). این مقدار بالاترین
# اولویت را دارد و در صورت پر بودن، PROXY_URL و GEMINI_API_KEY نادیده گرفته
# می‌شوند. راهنمای کامل ساخت و دیپلوی این بک‌اند در backend/firebase/README.md
# آمده است؛ مقدار زیر همان URL خروجی «npm run deploy» است.
# -----------------------------------------------------------------------
FIREBASE_FUNCTION_BASE_URL=
